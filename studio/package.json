{
  "name": "video-studio",
  "version": "1.0.0",
  "description": "Reusable Bengali motion-graphics templates (intro, lower thirds, callouts, outro, thumbnail)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/fonts": "4.0.536",
    "@remotion/tailwind-v4": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.536",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.536",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:alpha": "remotion render --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:mp4": "remotion render --codec=h264 --crf=16",
    "still": "remotion still --image-format=png"
  },
  "allowScripts": {
    "esbuild": false
  },
  "sideEffects": [
    "*.css"
  ]
}
